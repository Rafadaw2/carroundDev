{% extends 'base.html.twig' %}

{% block tittle %}
{{titulo}}

{% endblock %}

{% block body %}


 <table class="table table-striped" border="1" cellpadding="6" cellspacing="0">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Primer apellido</th>
                <th>Segundo apellido</th>
                <th>Domicilio</th>

            </tr>
        </thead>
        <tbody>
            {% for conductor in conductores %}
                
                <tr>
                    <td>{{ conductor.nombre}}</td>
                    <td>{{ conductor.apellido1 }}</td>
                    <td>{{ conductor.apellido2 }}</td>
                    <td>{{conductor.domicilio}}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>



{% endblock %}


<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Caround</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="{{ asset('css/styles.css.twig.css') }}">
</head>

<body>
  <!-- Navbar superior -->
  <nav class="navbar navbar-light bg-white shadow-sm px-3">
    <div class="container-fluid d-flex align-items-center justify-content-between">
      <!-- Botón hamburguesa visible solo en móviles -->
      <button class="btn d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu"
        aria-controls="mobileMenu">
        <i class="bi bi-list fs-3"></i>
      </button>

      <!-- Logo -->
      <a class="navbar-brand d-flex align-items-center me-auto ms-2" href="#">
        <img src="{{ asset('img/LOGO2.png') }}" alt="Caround Logo" class="logo" />
      </a>
    {% if is_granted('ROLE_PLANIFICADOR') or is_granted('ROLE_CLIENTE') %}
      <!-- Buscador -->
      <form method="get" action="/servicio/show/{matricula}" class="d-none d-md-flex mx-auto w-50">
        <input class="form-control form-control-sm me-2" type="search" name="matricula" placeholder="Buscar matrícula..." aria-label="Buscar">
        <button class="btn btn-outline-secondary btn-sm" type="submit">
          <i class="bi bi-search"></i>
        </button>
      </form>
    {% endif %}

      <!-- Icono de sesión -->
      <div class="dropdown ms-auto">
        <i class="bi bi-person-circle session-icon dropdown-toggle" id="sessionDropdown" data-bs-toggle="dropdown"
          aria-expanded="false"></i>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="sessionDropdown">
          {% if app.user %}
            <li><a class="dropdown-item" href="/logout">Cerrar sesión</a></li>
          {% else %}
            <li><a class="dropdown-item" href="/registro">Registrarse</a></li>
            <li><a class="dropdown-item" href="/login">Iniciar sesión</a></li>
          {% endif %}
          <li><hr class="dropdown-divider" /></li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Cuerpo principal -->
  <div class="container-fluid flex-grow-1 d-flex p-0">
    <!-- Menú lateral (solo en escritorio) -->
    <div class="col-2 sidebar d-none d-md-block">
      <ul class="nav flex-column">
        <li class="nav-item">
          <a class="nav-link active" href="/index">Inicio</a>
        </li>

        {% if is_granted('ROLE_PLANIFICADOR') %}
        <li class="nav-item">
          <a class="nav-link" href="/servicio/show">Servicios</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/servicio/new">➕ Servicio</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="{{ path('app_planificador') }}">Planificación</a>
        </li>
        {% endif %}

        {% if is_granted('ROLE_ADMIN') %}
        <li class="nav-item">
          <a class="nav-link" href="/admin">Administrar</a>
        </li>
        {% endif %}

        {% if is_granted('ROLE_MANAGER') %}
        <li class="nav-item">
          <a class="nav-link" href="/estadisticas">Estadísticas</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/registro">➕ Usuario</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#">Ver flota</a>
        </li>
        {% endif %}

        {% if is_granted('ROLE_CLIENTE') %}
        <li class="nav-item">
          <a class="nav-link" href="/servicio/show">Servicios</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/servicio/new">➕ Servicio</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#">Planificación</a>
        </li>
        {% endif %}
      </ul>
    </div>

    <!-- Menú móvil con offcanvas -->
    <div class="offcanvas offcanvas-start d-md-none" tabindex="-1" id="mobileMenu" aria-labelledby="mobileMenuLabel">
      <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="mobileMenuLabel">Menú</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
      </div>
      <div class="offcanvas-body">
        <ul class="nav flex-column">
          <li class="nav-item">
            <a class="nav-link" href="#">Inicio</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#">Vehículos</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#">Perfil</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Contenido -->
    <div class="col main-content">
      <h1>{% block tittle %}{% endblock %}</h1>
      {% block body %}{% endblock %}
    </div>
  </div>

  <!-- Footer -->
  <footer class="mt-auto">
    <p class="mb-0">&copy; 2025 Caround. Todos los derechos reservados.</p>
    <div>
      <a href="#" class="text-white me-3">Facebook</a>
      <a href="#" class="text-white me-3">Twitter</a>
      <a href="#" class="text-white">Instagram</a>
    </div>
  </footer>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>

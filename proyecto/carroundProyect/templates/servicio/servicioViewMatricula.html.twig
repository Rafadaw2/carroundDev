{% extends 'base.html.twig' %}

{% block tittle %}{{titulo}}{{matricula}}{% endblock %}

{% block body %}
<form class="d-flex align-items-center gap-2 mb-3 px-3" Smethod="get" style="display: flex; align-items: flex-start; gap: 10px; padding: 10px;" action="{{ path('app_show_servicio') }}">
 
    <label class="form-label">Mostrar los servicios de otra fecha</label>
    <input class="form-control" type="date" name="fecha" value="">


    <button class="btn btn-info btn-sm" type="submit">Filtrar</button>
  
</form>


  <div id="servicios" class="row row-cols-1 row-cols-md-5 g-4">
    {% for servicio in servicios %}
    <div class="col">
      <div id="servicios" class="card w-60 h-100">
          <h5 class="card-header">{{servicio.vehiculo.matricula}}</h5>
          <div class="card-body d-flex flex-column">
            <h5 class="card-title">{{servicio.receptor.nombre}}</h5>
            <p class="card-text">Franja: {{servicio.franjaDisponibilidad}}</p>
            <p class="card-text">Recogida: {{servicio.direccionRecogida}}</p>
            <p class="card-text">Entrega: {{servicio.direccionEntrega}}</strong></p>
            {% if is_granted('ROLE_PLANIFICADOR') %}
            <a href="/servicio/{{servicio.id}}/edit" class=" mt-auto btn btn-info">Modificar</a>
            {% endif %}
          </div>
      </div>
    </div>
    {% endfor %}
  </div>

{% endblock %}


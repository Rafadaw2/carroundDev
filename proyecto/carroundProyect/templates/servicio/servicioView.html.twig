{% extends 'plantilla.html.twig' %}

{% block titulo %}<h1>Login</h1>Servicios del {{fecha}}{% endblock %}

{% block contenido %}
<h1>Servicios del {{fecha}}</h1>
<form method="get" style="display: flex; align-items: flex-start; gap: 10px; padding: 10px;" action="{{ path('app_show_servicio') }}">
<h3 style="margin: 0;">Mostrar los servicios de otra fecha</h3>
    <input type="date" name="fecha" value="{{ fecha }}">
    <button type="submit">Filtrar</button>
</form>

  <div class="servicios">
    {% for servicio in servicios %}
            <div class="servicio" onclick="">
              <ul><h5>{{servicio.receptor.nombre}}, matricula {{servicio.vehiculo.matricula}}<a href="/servicio/{{servicio.id}}/edit">Modificar</a></h5></ul>
              
              <li><strong>Franja: {{servicio.franjaDisponibilidad}}</strong></li>
              <li><strong>Hora de recogida: {{servicio.horaRecogidaPrevista}}</strong></li>
              <li><strong>Dirección de recogida: {{servicio.direccionRecogida}}</strong></li>
              <li><strong>Coordenadas de recogida: {{servicio.latitudRecogida}}, {{servicio.longitudRecogida}}</strong></li>
              <li><strong>Dirección de entrega: {{servicio.direccionEntrega}}</strong></li>
              <li><strong>Coordenadas de entrega: {{servicio.latitudEntrega}}, {{servicio.longitudEntrega}}</strong></li>
              


            </div>
{% endfor %}
</div>

{% endblock %}


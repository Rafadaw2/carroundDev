{% extends 'base.html.twig' %}

{% block title %}Hello ServicioController!{% endblock %}

{% block body %}
    <div id='formulario'>
        {{ form_start(newServiceForm) }}

        {{ form_row(newServiceForm.direccionRecogida) }}
        {{ form_row(newServiceForm.direccionEntrega) }}
        {{ form_row(newServiceForm.fecha) }}
        {{ form_row(newServiceForm.horaRecogidaPrevista) }}
        {{ form_row(newServiceForm.franjaDisponibilidad) }}

        <div style="display: flex; align-items: center; gap: 10px;">
            {{ form_row(newServiceForm.vehiculo) }}
            <button type="button" class="btn btn-secondary" onclick="window.location.href='/vehiculo/new'">
                Añadir vehículo
            </button>
        </div>
        <div style="display: flex; align-items: center; gap: 10px;">
            {{ form_row(newServiceForm.receptor) }}
            <button type="button" class="btn btn-secondary" onclick="window.location.href='/receptor/new'">
                Añadir receptor
            </button>
        </div>

        {{ form_row(newServiceForm.creador) }}

        <button class="btn">Crear</button>
        {{ form_end(newServiceForm) }}

    </div>
    <style>
.autocomplete-suggestions {
    position: absolute;
    background: white;
    border: 1px solid #ccc;
    z-index: 1000;
    width: 100%;
    max-height: 150px;
    overflow-y: auto;
}
.autocomplete-suggestion {
    padding: 5px 10px;
    cursor: pointer;
}
.autocomplete-suggestion:hover {
    background-color: #e0e0e0;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.autocomplete-address').forEach(input => {
        let container = document.createElement('div');
        container.classList.add('autocomplete-suggestions');
        input.parentNode.appendChild(container);

        input.addEventListener('input', async () => {
            const query = input.value;
            if (query.length < 3) {
                container.innerHTML = '';
                return;
            }

            const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&limit=5&countrycodes=es&q=${encodeURIComponent(query)}`);
            const data = await response.json();

            container.innerHTML = '';
            data.forEach(item => {
                const option = document.createElement('div');
                option.classList.add('autocomplete-suggestion');
                const address = item.address;
                const calle = address.road || '';
                const numero = address.house_number || '';
                const municipio = address.city || address.town || address.village || '';
                const provincia = address.state || '';

                const direccionFormateada = `${calle} ${numero}, ${municipio}, ${provincia}`;
                option.textContent = direccionFormateada;

                option.addEventListener('click', () => {
                    input.value = item.display_name;
                    container.innerHTML = '';
                });
                container.appendChild(option);
            });
        });

        document.addEventListener('click', (e) => {
            if (!container.contains(e.target) && e.target !== input) {
                container.innerHTML = '';
            }
        });
    });
});
</script>

{% endblock %}


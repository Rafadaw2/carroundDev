{% extends 'base.html.twig' %}

{% block title %}Planificación del {{ fecha }}{% endblock %}

{% block body %}
<form class="d-flex align-items-center gap-2 mb-3 px-3" Smethod="get" style="display: flex; align-items: flex-start; gap: 10px; padding: 10px;" action="{{ path('app_show_planificacion') }}">
 
    <label class="form-label">Fecha: </label>
    <input class="form-control" type="date" name="fecha" value="{{ fecha }}">


    <button class="btn btn-info btn-sm" type="submit">Filtrar</button>
  
</form>
{% if servicios is not null %}
    {# renderiza la tabla como antes #}
{% else %}
    <div class="alert alert-warning">No se encontró planificación para el día seleccionado.</div>
{% endif %}

    <table class="table table-striped" border="1" cellpadding="6" cellspacing="0">
        <thead>
            <tr>
                <th>Matricula</th>
                <th>Hora de recogida</th>
                <th>Recogida</th>
                <th>Hora de entrega</th>
                <th>Entrega</th>
                <th>Conductor</th>
                <th>Receptor</th>

            </tr>
        </thead>
        <tbody>
            {% for servicio in servicios %}
                
                <tr>
                    <td>{{ servicio.vehiculo.matricula }}</td>
                    <td>{{ servicio.horaRecogidaPrevista }}</td>
                    <td>{{ servicio.direccionRecogida }}</td>
                    <td>{{servicio.horaEntregaPrevista}}</td>
                    <td>{{servicio.direccionEntrega}}</td>
                    <td>{{ servicio.conductor.nombre}}</td>
                    <td>{{servicio.receptor.nombre}}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>


{% endblock %}

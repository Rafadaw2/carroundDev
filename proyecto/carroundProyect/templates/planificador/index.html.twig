{% extends 'base.html.twig' %}

{% block tittle %}
{{titulo}} {{ fecha }}
<a href="/planificador/confirmar/{{fecha|date('Y-m-d') }}" class=" mt-auto btn btn-caround">Confirmar</a>
{% endblock %}


{% block body %}


{% if asignaciones is not null %}
    {# renderiza la tabla como antes #}
{% else %}
    <div class="alert alert-warning">No se pudo calcular una planificación válida.</div>
{% endif %}

{% for asignacion in asignaciones %}
    <h2>Conductor {{ conductores[asignacion.conductor_index].nombre }}, Domicilio: {{ conductores[asignacion.conductor_index].domicilio }}</h2>

    <table class="table table-striped" border="1" cellpadding="6" cellspacing="0">
        <thead>
            <tr>
                <th>Orden</th>
                <th>Tipo</th>
                <th>ID Servicio</th>
                <th>Hora estimada</th>
                <th>Dirección</th>
            </tr>
        </thead>
        <tbody>
            {% for paso in asignacion.ruta %}
                {% set servicio = servicios | filter(s => s.id == paso.servicio_id) | first %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td>{{ paso.tipo|capitalize }}</td>
                    <td>{{ paso.servicio_id }}</td>
                    <td>{{ paso.hora_estim | date('H:i', 'UTC') }}</td>
                    <td>
                        {% if paso.tipo == 'recogida' %}
                            {{ servicio.direccionRecogida }}
                        {% else %}
                            {{ servicio.direccionEntrega }}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% else %}
    <p>No hay asignaciones disponibles.</p>
{% endfor %}
{% endblock %}
